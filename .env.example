# Copy to .env.local and fill these in locally. Never commit real keys.
APP_MODE=simulation
OPENAI_API_KEY=
ZERION_API_KEY=
# Public address of the desktop EOA wallet used for the read-only probe.
DEMO_WALLET_ADDRESS=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
# Verified Arbitrum native-ETH route; no other source is supported.
ZERION_ATOMIC_SOURCE_ID=kyber
# Ethereum → Arbitrum ETH bridge, verified reference payload and preflight.
ZERION_BRIDGE_SOURCE_ID=lifi
# Vercel uses its project domain by default; override for custom domains.
APP_ORIGIN=
# Enable hosted API only after configuring Vercel Firewall rate limits.
PUBLIC_API_ENABLED=false
# Emergency API stop switch (all modes, including local).
API_ENABLED=true
